# Copied to deploy/record/env.local on first deploy (gitignored), then to the NAS as .env.
# Discord webhook for recorder alerts (Server Settings > Integrations > Webhooks). Optional:
# alerts always go to `docker logs clippa-record-record-1`.
CLIPPA_ALERT_WEBHOOK=
# Or set [record] alert_channel_id in clipper.toml and give the bot token here:
DISCORD_BOT_TOKEN=
# Owner of files written under CLIPPA_DATA (the NAS user Brandon is 1000:10).
PUID=1000
PGID=10
# The data folder (an env.local from before #286 pass 3 says CLIPPER_DATA: read the same)
CLIPPA_DATA=/volume1/docker/clipper
