# Copied to deploy/agent/env.local on first deploy (gitignored), then to the NAS as .env
# (chmod 600). deploy.sh moves OPENROUTER_API_KEY into ./openrouter_key (mode 600) and
# strips it from the .env the container sees. Do not set OPENCODE_PASSWORD or
# ANTHROPIC_API_KEY here: neither belongs in the container environment. The CLI and the
# models come from [agent] (clippa/defaults.toml), not from AGENT_CLI / AGENT_MODEL.
OPENROUTER_API_KEY=
KITSU_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
CLIPPA_ALERT_WEBHOOK=
# Optional, if not in secrets/: ELEVENLABS_API_KEY, BRAVE_API_KEY, OPENAI_API_KEY,
# GEMINI_API_KEY, HF_TOKEN. Leave ANTHROPIC_API_KEY unset.
# GitHub: a fine-grained token for this repo only (Contents and Pull requests: read and
# write), so a checkup PR can be pushed. Empty = read-only clone of a public repo.
GH_TOKEN=
# The repo to clone and who commits there; empty = this checkout's origin and git user
CLIPPA_REPO=
GIT_USER_NAME=
GIT_USER_EMAIL=
# Owner of files written under CLIPPA_DATA and AGENT_DIR, and the group of /dev/dri/renderD128
PUID=1000
PGID=10
RENDER_GID=105
CLIPPA_DATA=/volume1/docker/clipper
# The clone (repo/) and OpenCode's home (home/). Separate from clippa-claude.
AGENT_DIR=/volume1/docker/clippa-agent
# The checkup clock (HH:MM in TZ). Empty on purpose: this container comes up dark so it
# does not run beside clippa-claude's checkup. Set it only after that one is turned off.
CHECKUP_AT=
# After the checkup on these days (audit.sh; needs CHECKUP_AT): the weekly digest on
# AUDIT_WEEKDAY (1 = Monday ... 7 = Sunday), the deep audit on AUDIT_MONTHDAY; "" = off
AUDIT_WEEKDAY=7
AUDIT_MONTHDAY=1
# Phone bridge: not set here. Option A (the default) keeps the phone on clippa-claude.
# Option B would be a loopback OpenCode server and must not put a password in this file.
