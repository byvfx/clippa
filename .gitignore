# environments and caches
.venv/
# MkDocs build output. Generated pages live in docs-site/*.md (gitignored there).
/site/
__pycache__/
.ruff_cache/
# written into the staged copy by deploy/stamp.sh (the image has no .git), never the checkout
clippa/_build.txt

# data: streams live on the NAS share or a local folder, never in git
streams/
layouts/
/weekly/
studio/mockups/weekly/youtube_post/
voices/
faces/
archive/
lt/
rumble/
smoke/
logs/
*.log

# machine-specific config and secrets
clipper.toml
clipper.*.toml
!clipper.example.toml
secrets/
deploy/kitsu/env.local
deploy/record/env.local
deploy/hub/env.local
deploy/claude/env.local

# run state (upload schedule, analytics, `clipper setup` progress)
setup_state.json
schedule*.json
people.json
analytics.json
analytics_channel.json

# The old mockups/ folder: only the demo intro's working folder (mockups/demo-intro, large renders) is
# left in it, kept out of git. Its Udder Truth leftovers moved into studio/mockups/ on 11-20.
/mockups/

# Udder Truth performance takes (large phone video), under studio/
studio/mockups/udder_truth/takes/
*.mov
studio/mockups/udder_truth/mother_moo/*.png
studio/mockups/udder_truth/voice/
studio/mockups/udder_truth/storyboards/**/*.png
studio/mockups/udder_truth/storyboards/**/*.mp4

# hand-made copies before an edit (schedule.json, clipper.toml): backups/<file>.before_<what>_<date>
backups/

# video never goes in git (demo clips, renders)
*.mp4
news/

# Resolve export media for the 8-Bit Guy explainer prototype
studio/reports/8bitguy-explainer/resolve/media/
studio/reports/8bitguy-explainer/resolve/roomtone/

# Claude Code: its worktrees and this machine's own settings
.claude/worktrees/
.claude/settings.local.json
